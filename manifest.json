{
  "manifest_version": 3,
  "name": "Reelbox",
  "version": "0.1.0",
  "description": "Сохраняет открытый Reels одним нажатием в папку Загрузки/Reels.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Сохранить этот Reels",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/lib/extract.js", "src/lib/cache.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": [
        "src/lib/extract.js",
        "src/lib/cache.js",
        "src/content/target.js",
        "src/content/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
