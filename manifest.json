{
  "manifest_version": 3,
  "name": "Stash",
  "version": "0.9.7",
  "description": "Сохраняет кадры, ролики и звук из Instagram и TikTok одним нажатием.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokcdn-us.com/*",
    "*://*.tiktokv.com/*",
    "*://*.ibyteimg.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Сохранить этот кадр",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "src/lib/extract.js",
        "src/lib/sites/instagram.js",
        "src/lib/sites/tiktok.js",
        "src/lib/sites/registry.js",
        "src/lib/cache.js",
        "src/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "src/lib/extract.js",
        "src/lib/sites/instagram.js",
        "src/lib/sites/tiktok.js",
        "src/lib/sites/registry.js",
        "src/lib/cache.js",
        "src/lib/mp4audio.js",
        "src/content/target.js",
        "src/content/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
